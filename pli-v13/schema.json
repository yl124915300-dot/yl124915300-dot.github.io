{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "facts",
    "assumptions",
    "unknowns",
    "impact",
    "candidates"
  ],
  "properties": {
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 180
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "string",
        "maxLength": 160
      }
    },
    "unknowns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "impact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 220
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "description",
          "category",
          "cost_cents",
          "evidence_quote",
          "rationale"
        ],
        "properties": {
          "action": {
            "enum": [
              "simulate_plan",
              "ask",
              "pay",
              "order",
              "send_message",
              "cancel_real"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "category": {
            "enum": [
              "travel",
              "work",
              "household",
              "study",
              "other"
            ]
          },
          "cost_cents": {
            "type": "integer",
            "minimum": -1,
            "maximum": 100000
          },
          "evidence_quote": {
            "type": "string",
            "maxLength": 180
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          }
        }
      }
    }
  }
}